# PRAHARI backend environment variables.
# Copy to .env and fill in real values. Never commit .env.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- AI providers (primary = NVIDIA NIM, fallbacks = Groq / OpenRouter) ---
NVIDIA_API_KEY=
NVIDIA_EXPLANATION_MODEL=
NVIDIA_RECOMMENDATION_MODEL=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free

# --- Server ---
PORT=5001